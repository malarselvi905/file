# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Flask & Vault Security Keys
SECRET_KEY="generate-with-python-secrets-token-hex-32"
DATABASE_URL="mysql+pymysql://root:@localhost:3306/secure_file_vault"

# Master Encryption Key (AES-256 requires 32 bytes / 64 hex characters or 256-bit base64)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Application Configuration
FLASK_ENV="development"
MAX_CONTENT_LENGTH="15728640" # 15 MB in bytes
UPLOAD_FOLDER="./uploads"
SESSION_LIFETIME_MINUTES="15"
MAX_FAILED_LOGIN_ATTEMPTS="5"
ACCOUNT_LOCKOUT_MINUTES="15"

